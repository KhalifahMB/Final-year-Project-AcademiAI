# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=postgres://academiai_app:academiai_app@localhost:5432/academiai
POSTGRES_DB=academiai
POSTGRES_USER=academiai_app
POSTGRES_PASSWORD=academiai_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (cache only)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Celery broker)
CELERY_BROKER_URL=amqp://academiai:academiai@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object storage (MinIO local / S3 prod)
STORAGE_BACKEND=minio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=academiai-resources
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True
AWS_S3_SIGNATURE_VERSION=s3v4

# JWT
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (console backend for local; replace in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AcademiAI <noreply@academiai.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Security / rate limits (tune in production)
AUTH_VERIFICATION_CODE_EXPIRY_MINUTES=15
AUTH_PASSWORD_RESET_EXPIRY_MINUTES=30
AUTH_MAX_VERIFICATION_ATTEMPTS=5

# Logging
LOG_LEVEL=INFO
